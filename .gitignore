# ============================================================
# Ignore EVERYTHING at top level, then whitelist project dirs
# (git is in the home dir, so we exclude personal files)
# ============================================================
/*

# Whitelist: project files we WANT in the repo
!.gitignore
!.github/
!.github/**
!terraform/
!skydash/
!deploy/
!Documentation/
!scripts/
!scripts/**
!DOCUMENTATION_REVIEW.md
!START_HERE.md
!AGENT_ONBOARDING.md
!TASKS.md
!STATUS.md
!docs/
!docs/**
!package.json
!package-lock.json
!jest.config.js
!skydash/requirements.txt
!tests/
!tests/**

# ============================================================
# Re-ignore sensitive/junk INSIDE whitelisted dirs
# ============================================================

# Secrets — NEVER commit
terraform/.env
.env
.env.backup
*.tfvars
*.tfvars.json

# Terraform state & plugins
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate*
terraform/*.tfstate.*
terraform/crash.log

# Python
skydash/venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
skydash/__pycache__/
skydash/**/__pycache__/

# Logs
*.log
skydash/flask.log
skydash/autostart.log

# Runtime state (per-server, not source)
skydash/status_history.json*
skydash/.env

# Audit trail (append-only JSONL, §37) — NEVER commit; machine-generated
skydash/audit_logs/
skydash/audit_logs/*.jsonl

# Cline session data (large, private)
.cline/

# Iter 6 deployment & secrets runtime data (machine-generated) — NEVER commit
skydash/secrets_store.json
skydash/approval_log.jsonl
skydash/deployments/*.json
